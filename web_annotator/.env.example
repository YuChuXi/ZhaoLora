# 全局配置 (web_annotator 项目, 启动时统一加载)
# 复制本文件为 .env 并填写实际值; .env 已被 gitignore, 不会提交.
# - X: cookies 文件路径 (Netscape 格式, 含 auth_token/ct0 登录态)
# - Pixiv: cookies 文件路径 (Netscape 格式, 含 PHPSESSID 登录态)
# - Danbooru: 用户名 + API Key
# - Gelbooru: 用户 ID + API Key (标签补全与标签类型查询需要; 未配置时补全不可用)
# - 视频下载: BBDown 可执行文件路径 (B 站视频专用下载工具; 未配置时
#   改从 PATH 中查找 "BBDown"; 找不到则 B 站"下载视频"不可用)。
#   WEB 扫码登录凭证 (BBDown.data) 由 BBDown 自动从可执行文件同目录读取,
#   高清/会员内容依赖该登录态; 画质与编码优先级见下方 BBDOWN_DFN_PRIORITY
#   / BBDOWN_ENCODING_PRIORITY。
# - 服务器: 启动参数 (原 --data-dir 等), 由 FastAPI lifespan 统一读取
# 路径相对 web_annotator/ 目录解析; ANNOTATOR_DATA_DIR 相对启动时工作目录解析.

HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
X_COOKIES=../x.com_netscape_XXXXXXX.txt
PIXIV_COOKIES=../pixiv_cookies.txt
DANBOORU_LOGIN=
DANBOORU_API_KEY=
GELBOORU_USER_ID=
GELBOORU_API_KEY=
BBDOWN_PATH=
# B 站视频下载清晰度优先级 (BBDown -q, 逗号分隔), 留空取最高清晰度.
# 示例: BBDOWN_DFN_PRIORITY=1080P 高码率,1080P 高清,720P 高清
BBDOWN_DFN_PRIORITY=
# B 站视频下载编码优先级 (BBDown -e, 逗号分隔), 留空取 BBDown 默认.
# 示例: BBDOWN_ENCODING_PRIORITY=av1,hevc,avc
BBDOWN_ENCODING_PRIORITY=

# --- 自然语言描述标注 (描述页, 调用 Ollama 视觉模型) ---
# 描述服务: 逗号分隔的 "地址|模型" 对(地址含协议与端口), 多个服务时图片在服务间并行分发;
# 未配置时描述页不可用. 示例: http://10.0.0.1:11434|qwen3-vl:8b,http://10.0.0.2:11434|qwen3-vl:8b
CAPTION_OLLAMA_ENDPOINTS=
# 上下文长度; 留空为 0, 即不传 num_ctx, 由服务端默认值决定
CAPTION_NUM_CTX=
# 单张生成的最大 token 数; 留空为 8192, 0 表示不传 num_predict
CAPTION_NUM_PREDICT=
# 单张生成超时(秒); 留空为 60
CAPTION_TIMEOUT=

# --- 模型权重路径 ---
# 各推理模型权重来源: 本地路径或 HuggingFace repo id; 留空使用各模块内置默认值.
# WD14 打标: .onnx 权重文件路径 (标签表自动取同名 .csv)
WD14_MODEL=
# SAM3 概念分割: 模型目录或 HuggingFace repo id
SAM3_MODEL=
# BiRefNet 抠图: 权重文件 (safetensors/pt); 留空时从 HuggingFace 下载
BIREFNET_WEIGHT=
# 美学评分: CLIP 骨干 (OpenAI CLIP 模型名或本地权重路径) 与美学头 ckpt 文件
# (留空时从 HuggingFace 下载默认权重)
AESTHETIC_CLIP_MODEL=
AESTHETIC_HEAD_CKPT=
# 质量评分 / 重排序: 本地目录或 HuggingFace repo id
QREALIGN_MODEL=
RERANKER_MODEL=

# --- 服务器配置 ---
# 任务根目录 (任务须手动加入清单); 相对启动时工作目录(仓库根)解析
ANNOTATOR_DATA_DIR=datasets
# 缩略图长边像素 (默认 1280)
ANNOTATOR_THUMBNAIL_SIZE=1280
# 日志级别: debug/info/warning/error (默认 info)
ANNOTATOR_LOG_LEVEL=info
# 日志输出目录; 缺省写入 <data-dir>/logs
# ANNOTATOR_LOG_DIR=
# 屏蔽 QQ/微信/国产浏览器(UC/360/搜狗/百度/夸克等); 1 启用
# ANNOTATOR_BLOCK_CHINESE_UA=1
# 禁用浏览器缓存(所有响应附加 Cache-Control: no-store, 前端调试用); 1 启用
# ANNOTATOR_NO_BROWSER_CACHE=1
# 强制所有推理模型(打标/评分/去重/重排序/分割/抠图)仅用 CPU, 不占用 GPU 显存; 1 启用
# ANNOTATOR_CPU_ONLY=1

# sd-scripts 训练配置导出根目录: 就绪页「导出配置」写入 {SD_SCRIPTS_CONFIG_ROOT}/{数据集名}/ 下;
# 相对路径按 web_annotator/ 目录解析.
SD_SCRIPTS_CONFIG_ROOT=
# diffusion-pipe 训练配置导出根目录: 就绪页格式切换为 diffusion-pipe 时,
# 「导出配置」写入 {DIFFUSION_PIPE_CONFIG_ROOT}/{数据集名}/ 下; 相对路径按 web_annotator/ 目录解析.
DIFFUSION_PIPE_CONFIG_ROOT=
# diffusion-pipe 训练产物根目录: train.toml 的 output_dir 取 {DIFFUSION_PIPE_OUTPUT_ROOT}/{数据集名},
# 与配置目录分离; 相对路径按 web_annotator/ 目录解析.
DIFFUSION_PIPE_OUTPUT_ROOT=
# ComfyUI 模型根目录: 训练配置里的底模/VAE/文本编码器等权重路径均写作 {COMFYUI_MODELS_ROOT}/...,
# 模型目录迁移只需改此变量; 相对路径按 web_annotator/ 目录解析.
COMFYUI_MODELS_ROOT=
# 正则化数据集列表: 就绪页「正则化」开启时写入 dataset.toml 的数据块;
# 逗号分隔的 分辨率:目录绝对路径 项, 目录内图片须携带类提示词 caption(不含触发词).
REG_DATASETS=