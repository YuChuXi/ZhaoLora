max_steps = 500
micro_batch_size_per_gpu = 1
pipeline_stages = 1
gradient_accumulation_steps = 4
gradient_clipping = 0
warmup_steps = 50
smooth_l1_beta = 1.0
lr_scheduler = "cosine"
uncond_fraction = 0.1
eval_every_n_epochs = 1
eval_before_first_step = true
eval_micro_batch_size_per_gpu = 1
eval_gradient_accumulation_steps = 1
save_every_n_steps = 50
activation_checkpointing = true
partition_method = "parameters"
save_dtype = "bfloat16"
caching_batch_size = 1
map_num_proc = 16
steps_per_print = 1
blocks_to_swap = 20
compile = true
output_dir = "{{ output_dir }}"
dataset = "{{ dataset }}"
eval_datasets = []

[model]
type = "krea2"
diffusion_model = "/media/yuchuxi/Data/Servers/ComfyUI/models/diffusion_models/krea2_raw_bf16.safetensors"
vae = "/media/yuchuxi/Data/Servers/ComfyUI/models/vae/qwen_image_vae.safetensors"
text_encoders = [{path = "/media/yuchuxi/Data/Servers/ComfyUI/models/text_encoders/qwen3vl_4b_bf16.safetensors", type = "krea2"}]
dtype = "bfloat16"
diffusion_model_dtype = "float8"
timestep_sample_method = "logit_normal"
flux_shift = true

[adapter]
type = "lora"
dtype = "bfloat16"
dropout = 0.1
rank = {{ rank }}

[optimizer]
type = "adamw8bit"
lr = 0.0001
weight_decay = 0.001
betas = [0.9, 0.999]

[monitoring]
enable_wandb = true
wandb_tracker_name = "{{ wandb_tracker_name }}"
wandb_api_key = ""
wandb_run_name = ""
